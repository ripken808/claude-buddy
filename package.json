{
  "name": "claude-buddy",
  "version": "0.2.0",
  "description": "Tamagotchi-style desktop pet fed by Claude AI usage",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "NODE_ENV=development concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "dist": "npm run electron:build"
  },
  "build": {
    "appId": "com.ripken.claudebuddy",
    "productName": "Claude Buddy",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "public/icon.icns"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "./proxy",
        "to": "proxy",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      }
    ],
    "asar": true
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  }
}
