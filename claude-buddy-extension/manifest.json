{
  "manifest_version": 3,
  "name": "Claude Buddy Feed",
  "version": "1.0.0",
  "description": "Feeds Claude Buddy with real token usage from Claude.ai",
  "permissions": ["webRequest", "storage", "tabs"],
  "host_permissions": ["https://claude.ai/*", "http://localhost:7821/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
