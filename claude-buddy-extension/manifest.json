{
  "manifest_version": 3,
  "name": "Claude Buddy Feed",
  "version": "1.0.0",
  "description": "Feeds Claude Buddy with your real Claude usage data",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*", "http://localhost:7821/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Claude Buddy Feed"
  }
}
